<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/ezos_card_glass"
    app:cardElevation="1dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivContainerIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_launcher_foreground"
                app:tint="@color/ezos_accent"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContainerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Container"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvContainerDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XFCE4"
                    android:textColor="@color/ezos_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvContainerRes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="960×540"
                    android:textColor="@color/ezos_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnLaunchContainer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Launch"
            android:textColor="@color/ezos_bg_base"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_bg"
            android:paddingHorizontal="16dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>