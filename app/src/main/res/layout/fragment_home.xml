<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/ezos_bg_dark"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EZBox"
        android:textColor="@color/ezos_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="40dp"
        android:text="Powered by EZOS"
        android:textColor="@color/ezos_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ezos_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:contentPadding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Environment not running"
                android:textColor="@color/ezos_text_secondary"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressLaunch"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="@color/ezos_primary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Launch Environment"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/ezos_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
