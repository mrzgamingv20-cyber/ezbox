<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerHeader"
    android:layout_width="180dp"
    android:layout_height="match_parent"
    android:background="@color/ez_bg_surface"
    android:elevation="8dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/ez_bg_elevated"
        android:padding="16dp"
        android:gravity="bottom">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EZBox"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android desktop"
            android:textColor="@color/ezos_text_secondary"
            android:textSize="12sp" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menuItemTutorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_book"
                android:drawablePadding="12dp"
                android:text="Tutorial"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuItemStopDesktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_circle_stop"
                android:drawablePadding="12dp"
                android:text="Stop Desktop"
                android:textColor="@color/ezos_icon_rose"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuItemTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_laptop"
                android:drawablePadding="12dp"
                android:text="Terminal"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuItemSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="12dp"
                android:text="Settings"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuItemTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_palette"
                android:drawablePadding="12dp"
                android:text="Theme"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuItemAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="12dp"
                android:text="About"
                android:textColor="@color/ezos_text_primary"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>