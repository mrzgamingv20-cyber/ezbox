<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ezos_bg_base"
    android:fitsSystemWindows="true">

    <!-- VNC Screen - panel tombol user mengambang di atasnya -->
    <ImageView
        android:id="@+id/vncScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Panel tombol custom: diisi runtime, kosong by default.
         clickable=false supaya sentuhan tembus ke vncScreen saat panel kosong. -->
    <FrameLayout
        android:id="@+id/extraKeysPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Glass Status Card -->
    <LinearLayout
        android:id="@+id/vncStatusCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/ez_card_vnc"
        android:padding="24dp"
        android:elevation="8dp">

        <ProgressBar
            android:id="@+id/vncStatusSpinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/ezos_accent"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/vncStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/vncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:gravity="center"
            android:text="Connecting to EZOS desktop..." />

        <Button
            android:id="@+id/btnRetryConnection"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Retry"
            android:textSize="13sp"
            android:background="@drawable/btn_primary_bg"
            android:textColor="@android:color/white"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Stop Desktop Button - bening -->
    <Button
        android:id="@+id/btnStopDesktop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="14dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_glass_clear"
        android:drawableStart="@drawable/ic_circle_stop"
        android:drawablePadding="6dp"
        android:text="STOP"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <!-- Atur tombol custom - bening -->
    <Button
        android:id="@+id/btnEditKeys"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="14dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_glass_clear"
        android:drawableStart="@drawable/ic_sliders_horizontal"
        android:drawablePadding="4dp"
        android:text="Keys"
        android:textColor="@android:color/white"
        android:textSize="11sp" />

    <!-- Clipboard - bening -->
    <Button
        android:id="@+id/btnClipboard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="66dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_glass_clear"
        android:drawableStart="@drawable/ic_clipboard"
        android:drawablePadding="4dp"
        android:text="Copy"
        android:textColor="@android:color/white"
        android:textSize="11sp" />

    <!-- Screenshot - bening -->
    <Button
        android:id="@+id/btnScreenshot"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="66dp"
        android:layout_marginBottom="14dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_glass_clear"
        android:drawableStart="@drawable/ic_camera"
        android:drawablePadding="4dp"
        android:text="Snap"
        android:textColor="@android:color/white"
        android:textSize="11sp" />

    <!-- Typing Preview Bar - bening -->
    <TextView
        android:id="@+id/typingPreviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnToggleKeyboard"
        android:background="@drawable/btn_glass_clear"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:padding="12dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="start"
        android:visibility="gone" />

    <EditText
        android:id="@+id/hiddenInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:background="@android:color/transparent"
        android:textColor="@android:color/transparent"
        android:cursorVisible="false"
        android:inputType="textMultiLine"
        android:imeOptions="actionNone|flagNoExtractUi" />

    <!-- Toggle Keyboard - bening -->
    <Button
        android:id="@+id/btnToggleKeyboard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_glass_clear"
        android:drawableStart="@drawable/ic_keyboard"
        android:drawablePadding="4dp"
        android:text="KB"
        android:textColor="@android:color/white"
        android:textSize="11sp" />

</RelativeLayout>
