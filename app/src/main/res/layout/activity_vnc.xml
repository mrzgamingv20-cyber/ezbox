<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ImageView android:id="@+id/vncScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/vncStatusCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_glow_bg"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/vncStatusSpinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/ezos_accent"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/vncStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/vncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ezos_text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:text="Connecting to EZOS desktop..." />

        <Button
            android:id="@+id/btnRetryConnection"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Retry"
            android:textSize="12sp"
            android:background="@drawable/btn_primary_ripple"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>

    <Button
        android:id="@+id/btnStopDesktop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.6"
        android:textSize="16sp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="#66000000"
        android:text="⏻" />

    <!-- Tombol kecil trigger untuk expand/collapse toolbar extra keys -->
    <Button
        android:id="@+id/btnExpandKeys"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:alpha="0.6"
        android:textSize="16sp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="#66000000"
        android:text="⋯" />

    <HorizontalScrollView
        android:id="@+id/extraKeysBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginEnd="64dp"
        android:background="#CC000000"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
            <ToggleButton android:id="@+id/btnCtrl" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:textOn="Ctrl" android:textOff="Ctrl" android:layout_margin="2dp" />
            <ToggleButton android:id="@+id/btnAlt" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:textOn="Alt" android:textOff="Alt" android:layout_margin="2dp" />
            <Button android:id="@+id/btnSuper" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:text="Super" android:layout_margin="2dp" />
            <Button android:id="@+id/btnEsc" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:text="Esc" android:layout_margin="2dp" />
            <Button android:id="@+id/btnTab" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:text="Tab" android:layout_margin="2dp" />
            <Button android:id="@+id/btnF1" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="F1" android:layout_margin="2dp" />
            <Button android:id="@+id/btnF2" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="F2" android:layout_margin="2dp" />
            <Button android:id="@+id/btnF3" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="F3" android:layout_margin="2dp" />
            <Button android:id="@+id/btnF4" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="F4" android:layout_margin="2dp" />
            <Button android:id="@+id/btnHome" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="Home" android:layout_margin="2dp" />
            <Button android:id="@+id/btnEnd" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="End" android:layout_margin="2dp" />
            <Button android:id="@+id/btnPgUp" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="PgUp" android:layout_margin="2dp" />
            <Button android:id="@+id/btnPgDn" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="PgDn" android:layout_margin="2dp" />
            <Button android:id="@+id/btnDel" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="10sp" android:text="Del" android:layout_margin="2dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_margin="2dp">
                <Button android:id="@+id/btnUp" android:layout_width="34dp" android:layout_height="18dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="9sp" android:text="↑" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnLeft" android:layout_width="34dp" android:layout_height="18dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="9sp" android:text="←" />
                    <Button android:id="@+id/btnDown" android:layout_width="34dp" android:layout_height="18dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="9sp" android:text="↓" />
                    <Button android:id="@+id/btnRight" android:layout_width="34dp" android:layout_height="18dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="9sp" android:text="→" />
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/btnClipboard" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="14sp" android:text="📋" android:layout_margin="2dp" />
            <Button android:id="@+id/btnScreenshot" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:textSize="14sp" android:text="📷" android:layout_margin="2dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText android:id="@+id/hiddenInput" android:layout_width="1dp" android:layout_height="1dp" android:layout_gravity="bottom|start" android:background="@android:color/transparent" android:textColor="@android:color/transparent" android:cursorVisible="false" android:inputType="textMultiLine" android:imeOptions="actionNone|flagNoExtractUi" />

    <Button
        android:id="@+id/btnToggleKeyboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.7"
        android:text="⌨" />
</FrameLayout>
