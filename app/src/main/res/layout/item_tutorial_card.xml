<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_tutorial_bg"
    android:padding="18dp"
    android:layout_marginBottom="14dp">

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ezos_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ezos_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnCardAction"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/ezos_accent"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:textColor="@color/ezos_bg_black"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/btn_tutorial_more" />

</LinearLayout>
