<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ezos_bg_base">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ez_bg_elevated"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EZBox"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="user@ezbox · Android"
            android:textColor="@color/ezos_text_secondary"
            android:textSize="12sp" />

    </FrameLayout>

    <TextView
        android:id="@+id/menuItemTutorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_book"
                android:drawablePadding="12dp"
                android:text="Tutorial"
        android:textColor="@color/ezos_text_primary"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menuItemStopDesktop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_circle-stop"
                android:drawablePadding="12dp"
                android:text="Stop Desktop"
                android:textColor="@color/ezos_icon_rose"
        android:textColor="@color/ezos_icon_rose"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menuItemTerminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_laptop"
                android:drawablePadding="12dp"
                android:text="Terminal"
        android:textColor="@color/ezos_text_primary"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menuItemSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_info"
                android:drawablePadding="12dp"
                android:text="Settings"
        android:textColor="@color/ezos_text_primary"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menuItemTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_palette"
                android:drawablePadding="12dp"
                android:text="Theme"
        android:textColor="@color/ezos_text_primary"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menuItemAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:drawableStart="@drawable/ic_info"
                android:drawablePadding="12dp"
                android:text="About"
        android:textColor="@color/ezos_text_primary"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>